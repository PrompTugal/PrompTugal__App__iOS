	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>news.promptugal.reader</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>promptugal</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>WKAppBoundDomains</key>
	<array>
		<string>promptugal.news</string>
	</array>
</dict>
</plist>
