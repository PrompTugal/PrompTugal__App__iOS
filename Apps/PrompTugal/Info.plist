<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE = YES).
	     Only keys the INFOPLIST_KEY_ build settings cannot express live here.
	     No NFC (the public app has no Lanes). Purpose strings live in the project's INFOPLIST_KEY_ settings:
	     calendar write-only (add picks to the calendar) is the only one: the public app links no Ask, no vault and no
	     capture or speech code (PTAsk, PTVaultUI and SGitVault are Team-app only). Every framework the linked code uses that needs a
	     purpose string must have one, or App Store Connect fails processing (ITMS-90683).
	     Location (when in use only) is here: "Near me" in PTLocal works out which of the 17 Algarve towns is closest, on the
	     device, and keeps only that town's id. The location is never sent or stored. Asked only when the reader taps it. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>PrompTugal.news uses your location only while you use the app and only when you tap Near me, to find the nearest town and show its news first. Your location stays on this device.</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>news.promptugal.reader.refresh</string>
		<string>news.promptugal.reader.alerts</string>
	</array>
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>en-GB</string>
		<string>pt-PT</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>news.promptugal.reader</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>promptugal</string>
			</array>
		</dict>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleExternalDisplayNonInteractive</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>External Display</string>
					<key>UISceneDelegateClassName</key>
					<string>PTDeck.ExternalDisplaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>WKAppBoundDomains</key>
	<array>
		<string>promptugal.news</string>
	</array>
</dict>
</plist>
