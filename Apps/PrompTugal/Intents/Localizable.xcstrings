    "Open PrompTugal once to load the agenda.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح PrompTugal مرة واحدة لتحميل الجدول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie PrompTugal einmal, um das Programm zu laden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open PrompTugal once to load the agenda."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre PrompTugal una vez para cargar la agenda."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrí PrompTugal una vez para cargar la agenda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez PrompTugal une fois pour charger l’agenda."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एजेंडा लोड करने के लिए PrompTugal को एक बार खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednom otvorite PrompTugal za učitavanje rasporeda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri PrompTugal una volta per caricare l'agenda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度PrompTugalを開いてアジェンダを読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PrompTugal을 한 번 열어 일정을 불러오세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open PrompTugal één keer om het programma te laden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz PrompTugal raz, aby wczytać agendę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o PrompTugal uma vez para carregar a agenda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o PrompTugal uma vez para carregar a agenda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide PrompTugal o dată pentru a încărca agenda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先打开一次 PrompTugal 以加载日程。"
          }
        }
      }
    },
    "Says which session is next, in Lisbon time.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخبرك أي جلسة هي التالية، بتوقيت لشبونة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nennt die nächste Session, in Lissabonner Zeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Says which session is next, in Lisbon time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dice cuál es la siguiente sesión, en hora de Lisboa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique quelle session est la prochaine, à l’heure de Lisbonne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बताता है कि अगला सत्र कौन-सा है, लिस्बन समय में।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Govori koja je sesija sljedeća, po lisabonskom vremenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dice qual è la prossima sessione, all'ora di Lisbona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のセッションをリスボン時間でお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 세션이 무엇인지 리스본 시간으로 알려 줘요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zegt welke sessie hierna komt, in Lissabonse tijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaje, która sesja jest następna, w czasie lizbońskim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz qual é a próxima sessão, no horário de Lisboa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz qual é a próxima sessão, em hora de Lisboa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spune care este următoarea sesiune, în ora Lisabonei."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉你下一场是哪个，按里斯本时间。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
