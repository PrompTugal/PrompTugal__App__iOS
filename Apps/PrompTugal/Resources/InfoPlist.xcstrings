{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CFBundleDisplayName"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "PrompTugal"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "PrompTugal"
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NSCalendarsWriteOnlyAccessUsageDescription"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O PrompTugal adiciona ao seu calendário as sessões que você escolher, quando você pedir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PrompTugal adiciona ao seu calendário as sessões que escolher, quando lho pedir."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NSCameraUsageDescription"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O PrompTugal usa a câmera apenas para ler o QR code de uma chave do cofre, quando você escolher fazer isso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PrompTugal usa a câmara apenas para ler o código QR de uma chave do cofre, quando escolher lê-lo."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NSFaceIDUsageDescription"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O PrompTugal usa o Face ID para desbloquear as chaves do seu cofre neste aparelho."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PrompTugal usa o Face ID para desbloquear as chaves do seu cofre neste dispositivo."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PrompTugal uses the microphone while you hold the dictation button, to turn what you say into text for a question or a message. The audio is not kept."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O PrompTugal usa o microfone enquanto você mantém o botão de ditado pressionado, para transformar o que você diz em texto para uma pergunta ou uma mensagem. O áudio não é salvo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PrompTugal usa o microfone enquanto mantém premido o botão de ditado, para transformar o que diz em texto para uma pergunta ou uma mensagem. O áudio não é guardado."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PrompTugal turns your dictation into text. It does this on your device when your language allows it; otherwise your audio is sent to Apple to be transcribed."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O PrompTugal transforma seu ditado em texto. Isso é feito no seu aparelho quando o seu idioma permite; caso contrário, o áudio é enviado à Apple para ser transcrito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PrompTugal transforma o seu ditado em texto. Fá-lo no seu dispositivo quando o seu idioma o permite; caso contrário, o áudio é enviado à Apple para ser transcrito."
          }
        }
      }
    }
  },
  "version": "1.0"
}
