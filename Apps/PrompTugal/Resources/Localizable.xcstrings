    "Connect to load this talk's times and add it to your program.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصل بالإنترنت لتحميل مواعيد هذه المحاضرة وإضافتها إلى برنامجك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie sich, um die Zeiten dieses Talks zu laden und ihn zu Ihrem Programm hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to load this talk's times and add it to your program."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate para cargar los horarios de esta charla y añadirla a tu programa."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectate para cargar los horarios de esta charla y agregarla a tu programa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour charger les horaires de cette conférence et l’ajouter à votre programme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस टॉक का समय लोड करने और इसे अपने प्रोग्राम में जोड़ने के लिए कनेक्ट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povežite se da učitate termine ovog predavanja i dodate ga u svoj program."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connettiti per caricare gli orari di questo talk e aggiungerlo al tuo programma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続して、このトークの時間を読み込み、プログラムに追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결해서 이 토크의 시간을 불러오고 내 프로그램에 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak verbinding om de tijden van deze talk te laden en hem aan je programma toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz się, aby wczytać godziny tej prelekcji i dodać ją do programu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se para carregar os horários desta palestra e adicioná-la ao seu programa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue-se para carregar o horário desta sessão e a adicionar ao seu programa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează-te pentru a încărca orele acestei prezentări și a o adăuga în program."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "联网以加载此演讲的时间，并将其添加到你的日程。"
          }
        }
      }
    },
