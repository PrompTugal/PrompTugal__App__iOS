    "Collect your badge at Airport Terminal 1 (9–10 Nov) or Pavilhão de Portugal (9–12 Nov). Bring your ticket QR and photo ID.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استلم بطاقتك في Airport Terminal 1 (9–10 نوفمبر) أو Pavilhão de Portugal (9–12 نوفمبر). أحضر رمز QR الخاص بتذكرتك وهوية بصورة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Holen Sie Ihr Badge am Flughafen, Terminal 1 (9.–10. Nov.), oder im Pavilhão de Portugal (9.–12. Nov.) ab. Bringen Sie den QR-Code Ihres Tickets und einen Lichtbildausweis mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect your badge at Airport Terminal 1 (9–10 Nov) or Pavilhão de Portugal (9–12 Nov). Bring your ticket QR and photo ID."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect your badge at Airport Terminal 1 (Nov 9–10) or Pavilhão de Portugal (Nov 9–12). Bring your ticket QR and photo ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recoge tu acreditación en la Terminal 1 del aeropuerto (9–10 nov) o en el Pavilhão de Portugal (9–12 nov). Lleva el QR de tu entrada y un documento de identidad con foto."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirá tu acreditación en la Terminal 1 del aeropuerto (9–10 nov) o en el Pavilhão de Portugal (9–12 nov). Llevá el QR de tu entrada y un documento de identidad con foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirez votre badge au terminal 1 de l’aéroport (9–10 nov.) ou au Pavilhão de Portugal (9–12 nov.). Munissez-vous du QR code de votre billet et d’une pièce d’identité avec photo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना बैज Airport Terminal 1 (9–10 नवं) या Pavilhão de Portugal (9–12 नवं) से लें। अपना टिकट QR और फ़ोटो पहचान-पत्र साथ लाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podignite akreditaciju na Terminalu 1 zračne luke (9.–10. stu.) ili u Pavilhão de Portugal (9.–12. stu.). Ponesite QR kod ulaznice i osobnu iskaznicu s fotografijom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritira il badge al Terminal 1 dell'aeroporto (9–10 nov) o al Pavilhão de Portugal (9–12 nov). Porta il QR del biglietto e un documento con foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッジは空港ターミナル1（11/9～10）またはPavilhão de Portugal（11/9～12）で受け取れます。チケットのQRコードと写真付き身分証明書をお持ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공항 터미널 1(11월 9~10일) 또는 Pavilhão de Portugal(11월 9~12일)에서 배지를 받으세요. 티켓 QR 코드와 사진이 있는 신분증을 가져오세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haal je badge op bij Airport Terminal 1 (9–10 nov) of Pavilhão de Portugal (9–12 nov). Neem de QR-code van je ticket en een identiteitsbewijs met foto mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbierz identyfikator na Terminalu 1 lotniska (9–10 list.) lub w Pavilhão de Portugal (9–12 list.). Zabierz kod QR biletu i dokument ze zdjęciem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire seu crachá no Aeroporto, Terminal 1 (9–10 nov.), ou no Pavilhão de Portugal (9–12 nov.). Leve o QR code do ingresso e um documento de identidade com foto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Levante a sua credencial no Aeroporto, Terminal 1 (9–10 nov.), ou no Pavilhão de Portugal (9–12 nov.). Leve o QR do bilhete e um documento de identificação com fotografia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridică ecusonul de la Terminalul 1 al aeroportului (9–10 nov.) sau de la Pavilhão de Portugal (9–12 nov.). Ai la tine codul QR al biletului și un act de identitate cu fotografie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在机场 1 号航站楼（11月9日至10日）或 Pavilhão de Portugal（11月9日至12日）领取参会证。请携带票券二维码和带照片的身份证件。"
          }
        }
      }
    },
    "Collect your lanyard: Airport T1 (9–10 Nov) or Pavilhão de Portugal (9–12 Nov). Bring your ticket QR and photo ID.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استلم حبل بطاقتك في Airport T1 (9–10 نوفمبر) أو Pavilhão de Portugal (9–12 نوفمبر). أحضر رمز QR الخاص بتذكرتك وهوية بصورة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Holen Sie Ihr Lanyard ab: Flughafen T1 (9.–10. Nov.) oder Pavilhão de Portugal (9.–12. Nov.). Bringen Sie den QR-Code Ihres Tickets und einen Lichtbildausweis mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect your lanyard: Airport T1 (9–10 Nov) or Pavilhão de Portugal (9–12 Nov). Bring your ticket QR and photo ID."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect your lanyard: Airport T1 (Nov 9–10) or Pavilhão de Portugal (Nov 9–12). Bring your ticket QR and photo ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recoge tu acreditación: T1 del aeropuerto (9–10 nov) o Pavilhão de Portugal (9–12 nov). Lleva el QR de tu entrada y un documento de identidad con foto."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirá tu acreditación: T1 del aeropuerto (9–10 nov) o Pavilhão de Portugal (9–12 nov). Llevá el QR de tu entrada y un documento de identidad con foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirez votre tour de cou : terminal 1 de l’aéroport (9–10 nov.) ou Pavilhão de Portugal (9–12 nov.). Munissez-vous du QR code de votre billet et d’une pièce d’identité avec photo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना लैनयार्ड Airport T1 (9–10 नवं) या Pavilhão de Portugal (9–12 नवं) से लें। अपना टिकट QR और फ़ोटो पहचान-पत्र साथ लाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podignite vrpcu za akreditaciju: zračna luka T1 (9.–10. stu.) ili Pavilhão de Portugal (9.–12. stu.). Ponesite QR kod ulaznice i osobnu iskaznicu s fotografijom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritira il cordino: Aeroporto T1 (9–10 nov) o Pavilhão de Portugal (9–12 nov). Porta il QR del biglietto e un documento con foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランヤードは空港T1（11/9～10）またはPavilhão de Portugal（11/9～12）で受け取れます。チケットのQRコードと写真付き身分証明書をお持ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공항 T1(11월 9~10일) 또는 Pavilhão de Portugal(11월 9~12일)에서 목걸이 줄을 받으세요. 티켓 QR 코드와 사진이 있는 신분증을 가져오세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haal je lanyard op: Airport T1 (9–10 nov) of Pavilhão de Portugal (9–12 nov). Neem de QR-code van je ticket en een identiteitsbewijs met foto mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbierz smycz: lotnisko T1 (9–10 list.) lub Pavilhão de Portugal (9–12 list.). Zabierz kod QR biletu i dokument ze zdjęciem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire seu crachá: Aeroporto T1 (9–10 nov.) ou Pavilhão de Portugal (9–12 nov.). Leve o QR code do ingresso e um documento de identidade com foto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Levante a sua credencial: Aeroporto T1 (9–10 nov.) ou Pavilhão de Portugal (9–12 nov.). Leve o QR do bilhete e um documento de identificação com fotografia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridică șnurul de gât: Terminalul 1 al aeroportului (9–10 nov.) sau Pavilhão de Portugal (9–12 nov.). Ai la tine codul QR al biletului și un act de identitate cu fotografie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在机场 1 号航站楼（11月9日至10日）或 Pavilhão de Portugal（11月9日至12日）领取挂绳。请携带票券二维码和带照片的身份证件。"
          }
        }
      }
    },
