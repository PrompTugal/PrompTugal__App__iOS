    "Pick the talks you want. We'll warn you about clashes and remind you before each one.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر المحاضرات التي تريدها. سننبّهك إلى التعارضات ونذكّرك قبل كل منها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie die Talks, die Sie möchten. Wir warnen Sie vor Überschneidungen und erinnern Sie vor jedem Talk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the talks you want. We'll warn you about clashes and remind you before each one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las charlas que quieras. Te avisaremos de los solapamientos y te lo recordaremos antes de cada una."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegí las charlas que quieras. Te avisaremos de los solapamientos y te lo recordaremos antes de cada una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les conférences qui vous intéressent. Nous vous signalerons les conflits et vous rappellerons chacune avant son début."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने पसंदीदा टॉक चुनें। टकराव होने पर हम आपको चेताएँगे और हर टॉक से पहले याद दिलाएँगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite predavanja koja želite. Upozorit ćemo vas na preklapanja i podsjetiti vas prije svakog."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli i talk che ti interessano. Ti avviseremo delle sovrapposizioni e ti ricorderemo di ciascuno prima che inizi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "聴きたいトークを選んでください。重複はお知らせし、各トークの前にリマインドします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "듣고 싶은 토크를 선택하세요. 겹치면 알려 드리고, 각 토크 전에 알림을 드려요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de talks die je wilt. We waarschuwen je voor overlap en herinneren je vóór elke talk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz prelekcje, które Cię interesują. Ostrzeżemy Cię o kolizjach i przypomnimy przed każdą z nich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha as palestras que quiser. Avisamos sobre conflitos e lembramos antes de cada uma."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha as sessões que quer. Avisamos das sobreposições e lembramos antes de cada uma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege prezentările dorite. Te anunțăm despre suprapuneri și îți amintim înainte de fiecare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择你想听的演讲。如有冲突我们会提醒你，并在每场开始前提醒你。"
          }
        }
      }
    },
    "Pick your talks": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر محاضراتك"
          }
        },
