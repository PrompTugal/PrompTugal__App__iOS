    "PrompTugal reminds you before the sessions you pick.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يذكّرك PrompTugal قبل الجلسات التي تختارها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PrompTugal erinnert Sie vor den Sessions, die Sie auswählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PrompTugal reminds you before the sessions you pick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PrompTugal te avisa antes de las sesiones que eliges."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PrompTugal vous rappelle les sessions que vous choisissez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PrompTugal आपके चुने सत्रों से पहले आपको याद दिलाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "PrompTugal vas podsjeća prije sesija koje odaberete."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PrompTugal ti ricorda le sessioni che scegli prima che inizino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PrompTugalは、お気に入りに選んだセッションの前にお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PrompTugal이 선택한 세션 전에 알려 드려요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PrompTugal herinnert je vóór de sessies die je kiest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PrompTugal przypomni Ci przed wybranymi sesjami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O PrompTugal envia um aviso antes das sessões que você escolher."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PrompTugal envia um aviso antes das sessões que escolher."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "PrompTugal amintește înainte de sesiunile alese."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PrompTugal 会在你精选的场次开始前提醒你。"
          }
        }
      }
    },
    "Red line to Oriente, next to the venue. A summit transport pass is on sale.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخط الأحمر إلى Oriente، بجوار مقر القمة. تذكرة مواصلات القمة معروضة للبيع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rote Linie nach Oriente, direkt beim Veranstaltungsort. Ein Summit-Ticket für den Nahverkehr ist erhältlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Red line to Oriente, next to the venue. A summit transport pass is on sale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Línea roja hasta Oriente, junto al recinto. Hay a la venta un abono de transporte de la cumbre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligne rouge jusqu’à Oriente, à côté du site. Un pass transport du sommet est en vente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वेन्यू के पास Oriente तक रेड लाइन। समिट ट्रांसपोर्ट पास बिक्री पर है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crvena linija do Oriente, uz mjesto održavanja. U prodaji je prijevozna karta za summit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Linea rossa fino a Oriente, accanto alla sede. È in vendita un abbonamento ai trasporti per il summit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会場のすぐそば、レッドラインのOrienteへ。サミット用交通パスも販売中です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "행사장 바로 옆 Oriente행 레드 라인. 서밋 교통 패스를 판매 중이에요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rode lijn naar Oriente, naast de locatie. Er is een vervoersbewijs voor de summit te koop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czerwona linia do Oriente, obok miejsca wydarzenia. W sprzedaży jest bilet komunikacyjny na summit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Linha vermelha até Oriente, ao lado do local. Há um passe de transporte do evento à venda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Linha vermelha até ao Oriente, junto ao recinto. Está à venda um passe de transporte para a cimeira."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Linia roșie până la Oriente, lângă locație. Se vinde un abonament de transport pentru summit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "红线到 Oriente，就在会场旁边。出售峰会交通通票。"
          }
        }
      }
    },
