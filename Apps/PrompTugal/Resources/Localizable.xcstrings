    "My program puts your talks in order, marks the ones that clash and shows the gaps between them. A reminder comes before each one.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My program puts your talks in order, marks the ones that clash and shows the gaps between them. A reminder comes before each one."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meu programa coloca suas palestras em ordem, marca as que conflitam e mostra os intervalos entre elas. Um lembrete chega antes de cada uma."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O programa ordena as suas sessões por hora, assinala as que se sobrepõem e mostra os intervalos entre elas. Recebe um lembrete antes de cada uma."
          }
        }
      }
