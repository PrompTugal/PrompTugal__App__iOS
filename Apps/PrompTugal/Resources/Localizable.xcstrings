    "Road closures around Parque das Nações, 9–12 Nov.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إغلاق طرق حول Parque das Nações، 9–12 نوفمبر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Straßensperrungen rund um den Parque das Nações, 9.–12. Nov."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Strassensperrungen rund um den Parque das Nações, 9.–12. Nov."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Road closures around Parque das Nações, 9–12 Nov."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Road closures around Parque das Nações, Nov 9–12."
          }
        },
