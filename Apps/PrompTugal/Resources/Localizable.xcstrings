    "Star a talk, get a reminder before it starts": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع نجمة على محاضرة، وسيصلك تذكير قبل بدئها"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Talk mit Stern markieren, vor dem Start erinnert werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Star a talk, get a reminder before it starts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca una charla con una estrella y recibe un aviso antes de que empiece"
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcá una charla con una estrella y recibí un aviso antes de que empiece"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une conférence aux favoris et recevez un rappel avant son début"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी टॉक पर स्टार लगाएँ, शुरू होने से पहले रिमाइंडर पाएँ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Označite predavanje zvjezdicom i dobit ćete podsjetnik prije početka"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un talk ai preferiti e ricevi un promemoria prima che inizi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークにスターを付けると、開始前に通知されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토크에 별표를 달면 시작 전에 알림을 받아요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef een talk een ster en krijg een herinnering voor de start"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacz prelekcję gwiazdką i dostań przypomnienie przed jej początkiem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque uma palestra e receba um lembrete antes de ela começar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque uma sessão e receba um lembrete antes de começar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchează o prezentare cu stea și primiți un memento înainte de start"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为演讲加星标，开始前会收到提醒"
          }
        }
      }
    },
    "Star talks in Explore or on Now. They appear here in time order, with clashes marked.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع نجمة على المحاضرات في «استكشف» أو «الآن». تظهر هنا بترتيب الوقت مع تمييز التعارضات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markieren Sie Talks unter „Entdecken“ oder „Jetzt“ mit einem Stern. Sie erscheinen hier in zeitlicher Reihenfolge, Überschneidungen sind markiert."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Markieren Sie Talks unter «Entdecken» oder «Jetzt» mit einem Stern. Sie erscheinen hier in zeitlicher Reihenfolge, Überschneidungen sind markiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Star talks in Explore or on Now. They appear here in time order, with clashes marked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca charlas con una estrella en Explorar o en Ahora. Aparecerán aquí por orden de hora, con los solapamientos señalados."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcá charlas con una estrella en Explorar o en Ahora. Aparecerán aquí por orden de hora, con los solapamientos señalados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des conférences aux favoris dans Explorer ou sur Maintenant. Elles apparaissent ici dans l’ordre chronologique, conflits signalés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सप्लोर या अभी वाली स्क्रीन में टॉक पर स्टार लगाएँ। वे यहाँ समय के क्रम में दिखेंगे, टकराव चिह्नित होंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Označite predavanja zvjezdicom u Istraži ili u Sada. Ovdje se pojavljuju redom po vremenu, s označenim preklapanjima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi talk con la stella in Esplora o in Ora. Compaiono qui in ordine di orario, con le sovrapposizioni segnate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「探す」または「今」でトークにスターを付けてください。時間順に表示され、重複には印が付きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탐색이나 지금에서 토크에 별표를 다세요. 여기에 시간순으로 표시되고 겹치는 항목이 표시돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef talks een ster in Ontdekken of op Nu. Ze verschijnen hier op tijd, met overlap gemarkeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacz prelekcje gwiazdką w Odkrywaj lub w Teraz. Pojawią się tutaj w kolejności czasowej, z oznaczonymi kolizjami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque palestras com a estrela em Explorar ou em Agora. Elas aparecem aqui em ordem de horário, com os conflitos sinalizados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque sessões com a estrela em Explorar ou em Agora. Aparecem aqui por ordem de hora, com as sobreposições assinaladas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchează prezentări cu stea în Explorează sau în Acum. Apar aici în ordine cronologică, cu suprapunerile marcate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“探索”或“现在”中为演讲加星标。它们会按时间顺序显示在这里，并标出冲突。"
          }
        }
      }
    },
