    "The agenda and the news are saved here and work with no signal. Your picks never leave your phone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجدول والأخبار محفوظان هنا ويعملان دون إشارة. اختياراتك لا تغادر هاتفك أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Programm und News werden hier gespeichert und funktionieren ohne Empfang. Ihre Favoriten verlassen nie Ihr iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agenda and the news are saved here and work with no signal. Your picks never leave your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La agenda y las noticias se guardan aquí y funcionan sin cobertura. Tus favoritas nunca salen de tu teléfono."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "La agenda y las noticias se guardan aquí y funcionan sin señal. Tus favoritas nunca salen de tu celular."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La agenda y las noticias se guardan aquí y funcionan sin señal. Tus favoritas nunca salen de tu celular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agenda et l’actualité sont enregistrés ici et fonctionnent sans réseau. Vos choix ne quittent jamais votre téléphone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एजेंडा और समाचार यहीं सहेजे जाते हैं और बिना सिग्नल के भी चलते हैं। आपके चुने सत्र आपके फ़ोन से बाहर कभी नहीं जाते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raspored i vijesti spremljeni su ovdje i rade bez signala. Vaši odabiri nikad ne napuštaju vaš telefon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'agenda e le notizie sono salvate qui e funzionano senza segnale. Le tue scelte non lasciano mai il tuo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アジェンダとニュースはここに保存され、電波がなくても使えます。お気に入りがスマートフォンの外に出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정과 뉴스는 여기에 저장되어 신호가 없어도 사용할 수 있어요. 내 선택은 휴대폰 밖으로 나가지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het programma en het nieuws worden hier bewaard en werken zonder bereik. Je favorieten verlaten je telefoon nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenda i wiadomości są zapisane tutaj i działają bez zasięgu. Wybrane sesje nigdy nie opuszczają telefonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A agenda e as notícias ficam salvas aqui e funcionam sem sinal. Suas escolhas nunca saem do seu celular."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A agenda e as notícias ficam guardadas aqui e funcionam sem rede. As suas escolhas nunca saem do telemóvel."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenda și știrile sunt salvate aici și funcționează fără semnal. Alegerile tale nu părăsesc niciodată telefonul."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日程和新闻都保存在这里，没有信号也能使用。你的精选绝不会离开你的手机。"
          }
        }
      }
    },
    "The agenda could not be loaded.": {
