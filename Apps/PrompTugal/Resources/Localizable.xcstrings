    "Calendar access is off. Allow it in Settings to add talks.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى التقويم متوقف. اسمح به من الإعدادات لإضافة المحاضرات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kalenderzugriff ist ausgeschaltet. Erlauben Sie ihn in den Einstellungen, um Talks hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is off. Allow it in Settings to add talks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al calendario está desactivado. Permítelo en Ajustes para añadir charlas."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al calendario está desactivado. Permitilo en Ajustes para agregar charlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au calendrier est désactivé. Autorisez-le dans Réglages pour ajouter des conférences."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर की अनुमति बंद है। टॉक जोड़ने के लिए इसे सेटिंग्स में चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristup Kalendaru je isključen. Dopustite ga u Postavkama za dodavanje predavanja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso a Calendario è disattivato. Consentilo in Impostazioni per aggiungere i talk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーへのアクセスがオフです。トークを追加するには「設定」で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 접근이 꺼져 있어요. 토크를 추가하려면 설정에서 허용해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot de agenda staat uit. Sta het toe in Instellingen om talks toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do Kalendarza jest wyłączony. Zezwól na niego w Ustawieniach, aby dodawać prelekcje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao calendário está desativado. Permita-o nos Ajustes para adicionar palestras."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao calendário está desativado. Permita-o nas Definições para adicionar sessões."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesul la calendar este dezactivat. Permite-l din Setări pentru a adăuga prezentări."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历访问已关闭。请在“设置”中允许，以添加演讲。"
          }
        }
      }
    },
