    },
    "The app adds talks and never reads your calendar. Taking a pick off leaves its event in the calendar.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف التطبيق الجلسات ولا يقرأ تقويمك أبدًا. إزالة اختيار تترك حدثه في التقويم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App trägt Talks ein und liest deinen Kalender nie. Entfernst du eine Auswahl, bleibt der Termin im Kalender."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app adds talks and never reads your calendar. Taking a pick off leaves its event in the calendar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app añade charlas y nunca lee tu calendario. Si quitas una, su evento se queda en el calendario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app ajoute des talks et ne lit jamais votre calendrier. Retirer un choix laisse son événement dans le calendrier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप सत्र जोड़ता है और आपका कैलेंडर कभी नहीं पढ़ता। चुनाव हटाने पर उसका इवेंट कैलेंडर में रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija dodaje predavanja i nikad ne čita vaš kalendar. Uklonjeni odabir ostaje u kalendaru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app aggiunge i talk e non legge mai il tuo calendario. Se togli una scelta, l’evento resta nel calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリはトークを追加するだけで、カレンダーを読みません。選択を外してもカレンダーの予定は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱은 세션을 추가만 하고 캘린더를 읽지 않습니다. 선택을 취소해도 캘린더 일정은 남습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app zet talks erin en leest je agenda nooit. Haal je een keuze weg, dan blijft het item in je agenda."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja dodaje sesje i nigdy nie czyta kalendarza. Usunięcie wyboru zostawia wydarzenie w kalendarzu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app adiciona palestras e nunca lê sua agenda. Tirar uma escolha deixa o evento na agenda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A app adiciona palestras e nunca lê o seu calendário. Retirar uma escolha deixa o evento no calendário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația adaugă prezentări și nu îți citește niciodată calendarul. Dacă scoți o alegere, evenimentul rămâne în calendar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用只添加演讲,从不读取你的日历。取消选择后,日历里的活动会保留。"
          }
        }
      }
    },
