    "Each talk you pick goes into your phone's calendar with its time and hall. You can change this in More.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل جلسة تختارها تُضاف إلى تقويم هاتفك مع وقتها وقاعتها. يمكنك تغيير ذلك من «المزيد»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder gewählte Talk kommt mit Zeit und Halle in den Kalender deines Telefons. Ändern kannst du das unter Mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each talk you pick goes into your phone's calendar with its time and hall. You can change this in More."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada charla que elijas entra en el calendario del móvil con su hora y su pabellón. Puedes cambiarlo en Más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque talk choisi entre dans le calendrier de votre téléphone, avec son heure et sa salle. Modifiable dans Plus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जो भी सत्र चुनेंगे, वह समय और हॉल के साथ फ़ोन के कैलेंडर में जुड़ जाएगा। इसे 'और' में बदल सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svako odabrano predavanje ulazi u kalendar telefona s vremenom i dvoranom. To možete promijeniti pod Više."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni talk scelto entra nel calendario del telefono con orario e padiglione. Puoi cambiarlo in Altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだトークは時間と会場つきで電話のカレンダーに入ります。「その他」で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 세션은 시간과 홀 정보와 함께 휴대폰 캘린더에 들어갑니다. 더 보기에서 바꿀 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke gekozen talk komt met tijd en hal in de agenda van je telefoon. Je kunt dit wijzigen onder Meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda wybrana sesja trafia do kalendarza telefonu z godziną i salą. Zmienisz to w sekcji Więcej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada palestra escolhida entra na agenda do celular com horário e pavilhão. Você pode mudar isso em Mais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada palestra escolhida entra no calendário do telemóvel com a hora e o pavilhão. Pode alterar isto em Mais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare prezentare aleasă intră în calendarul telefonului, cu ora și sala. Poți schimba asta în Mai multe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选的每场演讲都会带着时间和场馆进入手机日历。可在“更多”中更改。"
          }
        }
      }
    },
