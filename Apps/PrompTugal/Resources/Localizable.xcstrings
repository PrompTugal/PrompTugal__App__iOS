    "My program puts your talks in order, marks the ones that clash and shows the gaps between them. A reminder comes before each one.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرتّب برنامجي محاضراتك، ويُظهر المتعارض منها، ويعرض الفترات الفاصلة بينها. يصلك تذكير قبل كل منها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mein Programm bringt Ihre Talks in die richtige Reihenfolge, markiert Überschneidungen und zeigt die Lücken dazwischen. Vor jedem Talk erhalten Sie eine Erinnerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My program puts your talks in order, marks the ones that clash and shows the gaps between them. A reminder comes before each one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi programa ordena tus charlas, marca las que se solapan y te muestra los huecos entre ellas. Recibirás un aviso antes de cada una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mon programme classe vos conférences dans l’ordre, repère celles qui se chevauchent et montre les temps libres entre elles. Un rappel vous prévient avant chacune."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“मेरा प्रोग्राम” आपके टॉक को क्रम में रखता है, टकराने वालों को चिह्नित करता है और उनके बीच के अंतराल दिखाता है। हर टॉक से पहले एक रिमाइंडर आता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moj program slaže vaša predavanja redom, označava ona koja se preklapaju i pokazuje razmake među njima. Prije svakog stiže podsjetnik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il mio programma mette in ordine i tuoi talk, segna quelli che si sovrappongono e mostra i vuoti tra l'uno e l'altro. Prima di ciascuno arriva un promemoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイプログラムは、トークを時間順に並べ、重複しているものに印を付け、間の空き時間を表示します。それぞれの前にリマインダーが届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 프로그램은 토크를 시간순으로 정리하고, 겹치는 토크를 표시하며, 그 사이의 빈 시간을 보여 줘요. 각 토크 전에 알림이 와요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijn programma zet je talks op volgorde, markeert de talks die overlappen en toont de gaten ertussen. Voor elke talk krijg je een herinnering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mój program układa prelekcje po kolei, oznacza te, które kolidują, i pokazuje przerwy między nimi. Przed każdą dostaniesz przypomnienie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meu programa coloca suas palestras em ordem, marca as que conflitam e mostra os intervalos entre elas. Um lembrete chega antes de cada uma."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O programa ordena as suas sessões por hora, assinala as que se sobrepõem e mostra os intervalos entre elas. Recebe um lembrete antes de cada uma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Programul meu pune prezentările în ordine, marchează suprapunerile și arată pauzele dintre ele. Un memento vine înainte de fiecare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“我的日程”会按时间顺序排列你的演讲，标出相互冲突的场次，并显示它们之间的空档。每场开始前都会提醒你。"
          }
        }
      }
    },
