    "What's on now, what clashes in my program, what's new today. Uses your own OpenRouter key.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يجري الآن، وما يتعارض في برنامجي، وما الجديد اليوم. يستخدم مفتاح OpenRouter الخاص بك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was läuft jetzt, was überschneidet sich in meinem Programm, was ist heute neu. Nutzt Ihren eigenen OpenRouter-Schlüssel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's on now, what clashes in my program, what's new today. Uses your own OpenRouter key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué hay ahora, qué se solapa en mi programa, qué hay de nuevo hoy. Usa tu propia clave de OpenRouter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui se passe maintenant, les conflits de mon programme, les nouveautés du jour. Utilise votre propre clé OpenRouter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी क्या चल रहा है, मेरे प्रोग्राम में क्या टकराता है, आज नया क्या है। आपकी अपनी OpenRouter कुंजी इस्तेमाल करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Što je upravo na redu, što se preklapa u mom programu, što je novo danas. Koristi vaš OpenRouter ključ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa c'è ora, quali talk si sovrappongono nel mio programma, cosa c'è di nuovo oggi. Usa la tua chiave OpenRouter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今開催中のもの、マイプログラムで重複しているもの、今日の新着。ご自身のOpenRouterキーを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 진행 중인 것, 내 프로그램에서 겹치는 것, 오늘의 새 소식. 내 OpenRouter 키를 사용해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat er nu is, wat er overlapt in mijn programma, wat er vandaag nieuw is. Gebruikt je eigen OpenRouter-sleutel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co trwa teraz, co koliduje w moim programie, co nowego dzisiaj. Używa Twojego klucza OpenRouter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que tem agora, o que conflita no meu programa, o que há de novo hoje. Usa sua própria chave OpenRouter."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que há agora, o que se sobrepõe no meu programa, o que há de novo hoje. Usa a sua própria chave OpenRouter."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce se întâmplă acum, ce se suprapune în programul meu, ce e nou azi. Folosește propria cheie OpenRouter."
