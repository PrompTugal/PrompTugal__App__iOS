    "Tap the star on any talk, in Explore or on Now. It goes into My program.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على النجمة في أي محاضرة، في «استكشف» أو «الآن». تنتقل إلى برنامجي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie bei einem Talk auf den Stern, unter „Entdecken“ oder „Jetzt“. Er landet in „Mein Programm“."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie bei einem Talk auf den Stern, unter «Entdecken» oder «Jetzt». Er landet in «Mein Programm»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the star on any talk, in Explore or on Now. It goes into My program."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la estrella de cualquier charla, en Explorar o en Ahora. Pasará a Mi programa."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocá la estrella de cualquier charla, en Explorar o en Ahora. Pasará a Mi programa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez l’étoile d’une conférence, dans Explorer ou sur Maintenant. Elle s’ajoute à Mon programme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सप्लोर या अभी वाली स्क्रीन में किसी भी टॉक के स्टार पर टैप करें। वह “मेरा प्रोग्राम” में चला जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite zvjezdicu na bilo kojem predavanju, u Istraži ili u Sada. Ide u Moj program."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca la stella su un talk, in Esplora o in Ora. Finisce in Il mio programma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「探す」または「今」で、トークのスターをタップしてください。マイプログラムに追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탐색이나 지금에서 토크의 별표를 탭하세요. 내 프로그램에 추가돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de ster bij een talk, in Ontdekken of op Nu. Hij komt in Mijn programma."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij gwiazdki przy dowolnej prelekcji, w Odkrywaj lub w Teraz. Trafi do Mojego programu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na estrela em qualquer palestra, em Explorar ou em Agora. Ela vai para Meu programa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na estrela em qualquer sessão, em Explorar ou em Agora. Entra no seu programa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge steaua de la o prezentare, în Explorează sau în Acum. Se adaugă în Programul meu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“探索”或“现在”中点按任意演讲上的星标，它就会加入“我的日程”。"
          }
        }
