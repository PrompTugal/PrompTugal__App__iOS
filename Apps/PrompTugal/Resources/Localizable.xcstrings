    "What is on now, what is next for you, what is new": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يجري الآن، وما التالي لك، وما الجديد"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was läuft jetzt, was kommt für Sie als Nächstes, was ist neu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is on now, what is next for you, what is new"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué hay ahora, qué sigue para ti, qué hay de nuevo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui se passe maintenant, la suite pour vous, les nouveautés"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी क्या चल रहा है, आपके लिए आगे क्या है, नया क्या है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Što je upravo na redu, što je sljedeće za vas, što je novo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa c'è ora, cosa c'è dopo per te, cosa c'è di nuovo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今開催中のもの、次の予定、新着情報"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 진행 중인 것, 다음 일정, 새로운 소식"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat er nu is, wat er voor jou nog komt, wat er nieuw is"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co trwa teraz, co dalej dla Ciebie, co nowego"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que está acontecendo, o que vem a seguir para você, o que há de novo"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que está a decorrer, o que vem a seguir para si, o que há de novo"
          }
        },
        "ro": {
          "stringUnit": {
