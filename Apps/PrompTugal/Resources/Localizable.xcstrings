    "Debug builds only. Shows the Debug screen and a native, web or hybrid badge on every screen.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لإصدارات تصحيح الأخطاء فقط. يعرض شاشة تصحيح الأخطاء وشارة أصلي أو ويب أو هجين على كل شاشة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur in Debug-Builds. Zeigt den Debug-Bildschirm und auf jedem Bildschirm ein Badge für nativ, Web oder hybrid."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug builds only. Shows the Debug screen and a native, web or hybrid badge on every screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo en compilaciones de depuración. Muestra la pantalla de depuración y una insignia nativa, web o híbrida en cada pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Versions de débogage uniquement. Affiche l’écran Débogage et un badge natif, web ou hybride sur chaque écran."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल डीबग बिल्ड के लिए। हर स्क्रीन पर डीबग स्क्रीन और नेटिव, वेब या हाइब्रिड बैज दिखाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo za debug verzije. Prikazuje zaslon za otklanjanje pogrešaka i izvornu, web ili hibridnu oznaku na svakom zaslonu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo build di debug. Mostra la schermata Debug e un badge nativo, web o ibrido su ogni schermata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバッグビルド専用です。デバッグ画面を表示し、各画面にネイティブ、Web、ハイブリッドのバッジを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디버그 빌드 전용이에요. 디버그 화면과 모든 화면의 네이티브, 웹, 하이브리드 배지를 표시해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen in debugbuilds. Toont het debugscherm en op elk scherm een badge voor native, web of hybride."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko kompilacje debugowania. Pokazuje ekran debugowania oraz znaczek natywny, webowy lub hybrydowy na każdym ekranie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas em builds de depuração. Mostra a tela de depuração e um selo nativo, web ou híbrido em cada tela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas em versões de depuração. Mostra o ecrã de depuração e um selo nativo, web ou híbrido em cada ecrã."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar pentru versiunile de depanare. Afișează ecranul Depanare și o insignă nativ, web sau hibrid pe fiecare ecran."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限调试版本。显示“调试”屏幕，并在每个屏幕上显示原生、网页或混合徽标。"
          }
        }
      }
    },
