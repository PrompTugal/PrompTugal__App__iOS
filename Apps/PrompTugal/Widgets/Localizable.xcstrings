    "The session happening now and what comes next, in Lisbon time.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجلسة الجارية الآن وما يليها، بتوقيت لشبونة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuelle Session und die nächste, in Lissabonner Zeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session happening now and what comes next, in Lisbon time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión que está en marcha y la siguiente, en hora de Lisboa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session en cours et la suivante, à l’heure de Lisbonne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी चल रहा सत्र और उसके बाद क्या है, लिस्बन समय में।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesija koja je upravo na redu i ona koja slijedi, po lisabonskom vremenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione in corso e quella successiva, all'ora di Lisbona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リスボン時間で、現在のセッションと次のセッションを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 진행 중인 세션과 다음 세션, 리스본 시간 기준."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sessie die nu bezig is en wat erna komt, in Lissabonse tijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwająca sesja i następna, w czasie lizbońskim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão acontecendo agora e a próxima, no horário de Lisboa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão a decorrer agora e a seguinte, em hora de Lisboa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiunea în desfășurare și următoarea, în ora Lisabonei."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "里斯本时间当前进行的场次以及接下来的安排。"
          }
        }
      }
    }
  },
