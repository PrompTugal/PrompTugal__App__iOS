          "stringUnit": {
            "state": "translated",
            "value": "افتح PrompTugal لتحميل الجدول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie PrompTugal, um das Programm zu laden."
          }
        },
