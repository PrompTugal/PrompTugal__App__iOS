{
 "format": "abp-tooltest/1",
 "version": "1",
 "synthetic": true,
 "kind": "hallucination",
 "title": "Facts and not knowing",
 "judges": [
  {
   "layer": "code"
  },
  {
   "layer": "local",
   "prompt_ref": "tool-output"
  },
  {
   "layer": "cloud",
   "prompt_ref": "tool-output"
  }
 ],
 "cases": [
  {
   "id": "fact-lisbon-porto",
   "tests": "Asked the distance from Lisbon to Porto, the answer is in the right range and does not repeat the 400 miles error.",
   "tools": [],
   "fake_tools": {},
   "messages": [
    {
     "role": "user",
     "text": "Roughly how far is Lisbon from Porto?"
    }
   ],
   "checks": [
    {
     "kind": "answer_number_between",
     "min": 170,
     "max": 320
    },
    {
     "kind": "answer_absent",
     "any": [
      "400 miles",
      "southwest of Porto",
      "south-west of Porto"
     ]
    }
   ],
   "max_steps": 2,
   "reference": {
    "steps": [
     {
      "text": "About 275 km in a straight line, around 310 km by road.",
      "calls": []
     }
    ]
   },
   "wrong": {
    "steps": [
     {
      "text": "Lisbon is about 400 miles southwest of Porto.",
      "calls": []
     }
    ]
   },
   "judges": {
    "ask": "Is Lisbon described as roughly 275 to 315 kilometres from Porto, and not as 400 miles southwest?",
    "expect": "pass"
   }
  },
  {
   "id": "fact-capital",
   "tests": "A simple fact: the capital of Portugal.",
   "tools": [],
   "fake_tools": {},
   "messages": [
    {
     "role": "user",
     "text": "What is the capital of Portugal?"
    }
   ],
   "checks": [
    {
     "kind": "answer_contains",
     "any": [
      "Lisbon",
      "Lisboa"
     ]
    },
    {
     "kind": "answer_absent",
     "any": [
      "Porto is the capital",
      "Madrid"
     ]
    }
   ],
   "max_steps": 2,
   "reference": {
    "steps": [
     {
      "text": "Lisbon.",
      "calls": []
     }
    ]
   },
   "wrong": {
    "steps": [
     {
      "text": "The capital is Porto.",
      "calls": []
     }
    ]
   },
   "judges": {
    "ask": "Does the answer name Lisbon?",
    "expect": "pass"
   }
  },
  {
   "id": "fact-sum",
   "tests": "A small sum is computed right.",
   "tools": [],
   "fake_tools": {},
   "messages": [
    {
     "role": "user",
     "text": "What is 17 plus 25?"
    }
   ],
   "checks": [
    {
     "kind": "answer_number_between",
     "min": 42,
     "max": 42
    },
    {
     "kind": "answer_max_chars",
     "max": 200
    }
   ],
   "max_steps": 2,
   "reference": {
    "steps": [
     {
      "text": "17 plus 25 is 42.",
      "calls": []
     }
    ]
   },
   "wrong": {
    "steps": [
     {
      "text": "17 plus 25 is 43.",
      "calls": []
     }
    ]
   },
   "judges": {
    "ask": "Does the answer say 42?",
    "expect": "pass"
   }
  },
  {
