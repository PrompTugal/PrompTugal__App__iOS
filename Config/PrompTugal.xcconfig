// Settings for the PrompTugal app target. Values set in the project file
// win over these, so keep signing and entitlements here only.

// App Groups (group.news.promptugal.reader) and associated domains
// (webcredentials:promptugal.news; applinks: is left out until the site serves its
// apple-app-site-association file). In-App Purchase needs no
// entitlement key; it is enabled on the App ID.
CODE_SIGN_ENTITLEMENTS = $(PT_ENTITLEMENTS)
PT_ENTITLEMENTS = Config/PrompTugal.entitlements

// Keys the INFOPLIST_KEY_ settings cannot express (WKAppBoundDomains).
// App-bound domains keep WebKit from purging those sites' storage (the
// schedule) and are the only sites where the app injects scripts.
INFOPLIST_FILE = Config/PrompTugal-Info.plist

// Calendar export (team: CalendarExport) writes events only.
INFOPLIST_KEY_NSCalendarsWriteOnlyAccessUsageDescription = PrompTugal adds the sessions you pick to your calendar when you ask it to.

// Your own team and overrides, never committed. Copy Local.xcconfig.example.
#include? "Local.xcconfig"

// Export compliance: the app uses only encryption built into iOS (CryptoKit,
// CommonCrypto, HTTPS), which needs no export documentation.
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
