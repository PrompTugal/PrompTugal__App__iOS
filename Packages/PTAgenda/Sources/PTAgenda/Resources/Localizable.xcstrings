    "Saving needs your vault opened with its vault key and an access token.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب الحفظ فتح خزنتك بمفتاح الخزنة ورمز وصول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Sichern muss Ihr Tresor mit dem Tresorschlüssel geöffnet sein und ein Zugriffstoken vorliegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving needs your vault opened with its vault key and an access token."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para guardar hay que abrir la bóveda con su clave de bóveda y tener un token de acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement exige que votre coffre-fort soit ouvert avec sa clé de coffre-fort et un jeton d’accès."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजने के लिए आपका वॉल्ट उसकी वॉल्ट कुंजी से खुला होना और एक एक्सेस टोकन चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremanje traži vaš sef otvoren ključem sefa i pristupni token."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per salvare serve la tua cassaforte aperta con la sua chiave e un token di accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存するには、ボールトキーでボールトを開き、アクセストークンを設定する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하려면 볼트 키로 볼트를 열고 액세스 토큰이 있어야 해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opslaan vereist dat je kluis is geopend met de kluissleutel en een toegangstoken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapis wymaga sejfu otwartego kluczem sejfu i tokenu dostępu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para salvar, o cofre precisa estar aberto com a chave do cofre e um token de acesso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para guardar, o cofre tem de estar aberto com a chave do cofre e um token de acesso."
          }
        },
        "ro": {
