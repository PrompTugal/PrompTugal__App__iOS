    "Stand-ups come from the team site, with a link to your briefing.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأتي الاجتماعات القصيرة من موقع الفريق، مع رابط إلى موجزك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand-ups stammen von der Team-Website, mit einem Link zu Ihrem Briefing."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand-ups come from the team site, with a link to your briefing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reuniones vienen del sitio del equipo, con un enlace a tu resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les stand-ups viennent du site de l’équipe, avec un lien vers votre briefing."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टैंड-अप टीम साइट से आते हैं, आपकी ब्रीफ़िंग के लिंक के साथ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand-upovi dolaze s web-stranice tima, s poveznicom na vaš briefing."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli stand-up vengono dal sito del team, con un link al tuo briefing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタンドアップはチームのサイトから届き、ブリーフィングへのリンクが付きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스탠드업은 팀 사이트에서 가져오며, 브리핑 링크가 포함돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand-ups komen van de teamsite, met een link naar je briefing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand-upy pochodzą ze strony zespołu, z linkiem do Twojego briefingu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os stand-ups vêm do site da equipe, com um link para o seu briefing."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os stand-ups vêm do site da equipa, com uma ligação para o seu briefing."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand-up-urile vin de pe site-ul echipei, cu un link către briefing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站会来自团队网站，附有指向你简报的链接。"
          }
        }
      }
    },
    "Star talks in Explore or on Now. They appear here in time order, with clashes marked.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع نجمة على المحاضرات في «استكشف» أو «الآن». تظهر هنا بترتيب الوقت مع تمييز التعارضات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markieren Sie Talks unter „Entdecken“ oder „Jetzt“ mit einem Stern. Sie erscheinen hier in zeitlicher Reihenfolge, Überschneidungen sind markiert."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Markieren Sie Talks unter «Entdecken» oder «Jetzt» mit einem Stern. Sie erscheinen hier in zeitlicher Reihenfolge, Überschneidungen sind markiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Star talks in Explore or on Now. They appear here in time order, with clashes marked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca charlas con una estrella en Explorar o en Ahora. Aparecerán aquí por orden de hora, con los solapamientos señalados."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcá charlas con una estrella en Explorar o en Ahora. Aparecerán aquí por orden de hora, con los solapamientos señalados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des conférences aux favoris dans Explorer ou sur Maintenant. Elles apparaissent ici dans l’ordre chronologique, conflits signalés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सप्लोर या अभी वाली स्क्रीन में टॉक पर स्टार लगाएँ। वे यहाँ समय के क्रम में दिखेंगे, टकराव चिह्नित होंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Označite predavanja zvjezdicom u Istraži ili u Sada. Ovdje se pojavljuju redom po vremenu, s označenim preklapanjima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi talk con la stella in Esplora o in Ora. Compaiono qui in ordine di orario, con le sovrapposizioni segnate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「探す」または「今」でトークにスターを付けてください。時間順に表示され、重複には印が付きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탐색이나 지금에서 토크에 별표를 다세요. 여기에 시간순으로 표시되고 겹치는 항목이 표시돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef talks een ster in Ontdekken of op Nu. Ze verschijnen hier op tijd, met overlap gemarkeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacz prelekcje gwiazdką w Odkrywaj lub w Teraz. Pojawią się tutaj w kolejności czasowej, z oznaczonymi kolizjami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque palestras com a estrela em Explorar ou em Agora. Elas aparecem aqui em ordem de horário, com os conflitos sinalizados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque sessões com a estrela em Explorar ou em Agora. Aparecem aqui por ordem de hora, com as sobreposições assinaladas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchează prezentări cu stea în Explorează sau în Acum. Apar aici în ordine cronologică, cu suprapunerile marcate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“探索”或“现在”中为演讲加星标。它们会按时间顺序显示在这里，并标出冲突。"
          }
        }
      }
    },
