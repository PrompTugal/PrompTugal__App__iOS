    "Calendar access is off for this app. Turn it on in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى التقويم متوقف لهذا التطبيق. فعّله من الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kalenderzugriff ist für diese App ausgeschaltet. Schalten Sie ihn in den Einstellungen ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is off for this app. Turn it on in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al calendario está desactivado para esta app. Actívalo en Ajustes."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al calendario está desactivado para esta app. Activalo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au calendrier est désactivé pour cette app. Activez-le dans Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस ऐप के लिए कैलेंडर की अनुमति बंद है। इसे सेटिंग्स में चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristup Kalendaru isključen je za ovu aplikaciju. Uključite ga u Postavkama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso a Calendario è disattivato per questa app. Attivalo in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリのカレンダーアクセスがオフです。「設定」でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱의 캘린더 접근이 꺼져 있어요. 설정에서 켜 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot de agenda staat uit voor deze app. Zet hem aan in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do Kalendarza jest wyłączony dla tej aplikacji. Włącz go w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao calendário está desativado para este app. Ative-o nos Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao calendário está desativado para esta app. Ative-o nas Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesul la calendar este dezactivat pentru această aplicație. Activează-l din Setări."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 的日历访问已关闭。请在“设置”中开启。"
          }
        }
      }
    },
    "Calendar access was not given. You can allow it in Settings.": {
