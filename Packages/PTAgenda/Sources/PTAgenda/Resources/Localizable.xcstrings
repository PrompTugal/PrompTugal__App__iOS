    "Walking times are estimates: 5 minutes between rooms at the venue, 25 to anywhere else. All times are Lisbon time.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقات المشي تقديرية: 5 دقائق بين القاعات في مقر القمة، و25 إلى أي مكان آخر. كل الأوقات بتوقيت لشبونة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehzeiten sind Schätzwerte: 5 Minuten zwischen Räumen am Veranstaltungsort, 25 überallhin sonst. Alle Zeiten sind Lissabonner Zeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walking times are estimates: 5 minutes between rooms at the venue, 25 to anywhere else. All times are Lisbon time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tiempos a pie son estimaciones: 5 minutos entre salas del recinto y 25 a cualquier otro sitio. Todas las horas son de Lisboa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les temps de marche sont des estimations : 5 minutes entre les salles du site, 25 pour aller ailleurs. Toutes les heures sont à l’heure de Lisbonne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैदल चलने का समय अनुमान है: वेन्यू में कमरों के बीच 5 मिनट, कहीं और जाने के लिए 25। सभी समय लिस्बन समय में हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vremena hoda su procjene: 5 minuta između dvorana na mjestu održavanja, 25 do bilo kojeg drugog mjesta. Sva su vremena po lisabonskom vremenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tempi a piedi sono stime: 5 minuti tra le sale della sede, 25 per qualsiasi altro posto. Tutti gli orari sono all'ora di Lisbona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "徒歩時間は目安です。会場内の部屋間は5分、それ以外はどこでも25分です。時間はすべてリスボン時間です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도보 시간은 추정치예요. 행사장 안의 방 사이는 5분, 그 밖의 곳은 어디든 25분이에요. 모든 시간은 리스본 시간이에요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Looptijden zijn schattingen: 5 minuten tussen zalen op de locatie, 25 naar elke andere plek. Alle tijden zijn Lissabonse tijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czasy przejścia to szacunki: 5 minut między salami w miejscu wydarzenia, 25 w każde inne miejsce. Wszystkie godziny podano w czasie lizbońskim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tempos de caminhada são estimativas: 5 minutos entre salas no local, 25 para qualquer outro lugar. Todos os horários são de Lisboa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tempos de deslocação são estimativas: 5 minutos entre salas no recinto, 25 para qualquer outro sítio. Todas as horas são de Lisboa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Timpii de mers sunt estimări: 5 minute între sălile de la locație, 25 oriunde în altă parte. Toate orele sunt în ora Lisabonei."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "步行时间为估算值：会场内房间之间 5 分钟，到其他任何地方 25 分钟。所有时间均为里斯本时间。"
          }
        }
      }
    },
