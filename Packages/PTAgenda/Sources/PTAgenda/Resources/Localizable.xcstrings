    "Sessions the team picked for you rank first, then sessions teammates have, then ones like your picks.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأتي أولًا الجلسات التي اختارها لك الفريق، ثم جلسات زملائك، ثم جلسات تشبه اختياراتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst stehen Sessions, die das Team für Sie ausgewählt hat, dann Sessions von Teamkollegen, dann solche, die Ihren Favoriten ähneln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions the team picked for you rank first, then sessions teammates have, then ones like your picks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero van las sesiones que el equipo ha elegido para ti, después las de tus compañeros y luego las parecidas a tus favoritas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sessions choisies pour vous par l’équipe arrivent en premier, puis celles de vos coéquipiers, puis celles proches de vos choix."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीम के आपके लिए चुने सत्र सबसे ऊपर आते हैं, फिर वे सत्र जो साथियों के पास हैं, फिर आपके चुने सत्रों जैसे सत्र।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvo idu sesije koje je tim odabrao za vas, zatim sesije koje imaju kolege, pa one slične vašim odabirima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima vengono le sessioni scelte per te dal team, poi quelle dei colleghi, poi quelle simili alle tue scelte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームがあなたのために選んだセッションが最初に、次にチームメイトのセッション、その次にお気に入りに似たセッションが並びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팀이 골라 준 세션이 맨 위에 오고, 그다음 팀원들의 세션, 그다음 내 선택과 비슷한 세션이 와요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessies die het team voor jou koos staan bovenaan, dan sessies van teamgenoten, dan sessies zoals je favorieten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na początku są sesje wybrane dla Ciebie przez zespół, potem sesje, które mają koledzy, a potem podobne do Twoich wybranych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro aparecem as sessões que a equipe escolheu para você, depois as que os colegas têm e, por fim, as parecidas com as suas escolhas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro aparecem as sessões que a equipa escolheu para si, depois as que os colegas têm e, por fim, as parecidas com as suas escolhas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiunile alese pentru tine de echipă apar primele, apoi cele ale colegilor, apoi cele asemănătoare cu alegerile tale."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "团队为你精选的场次排在最前，其次是队友的场次，然后是与你的精选相似的场次。"
          }
        }
      }
    },
