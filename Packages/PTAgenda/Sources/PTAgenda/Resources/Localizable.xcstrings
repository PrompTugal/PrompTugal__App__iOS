    "Kept on this device in the website’s format (nr.schedule.v1), and synced with promptugal.news when you open it in the app.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ على هذا الجهاز بصيغة الموقع (nr.schedule.v1)، ويُزامَن مع promptugal.news عند فتحه في التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät im Format der Website (nr.schedule.v1) gespeichert und mit promptugal.news abgeglichen, wenn Sie es in der App öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept on this device in the website’s format (nr.schedule.v1), and synced with promptugal.news when you open it in the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda en este dispositivo con el formato del sitio web (nr.schedule.v1) y se sincroniza con promptugal.news cuando lo abres en la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservé sur cet appareil au format du site web (nr.schedule.v1) et synchronisé avec promptugal.news quand vous l’ouvrez dans l’app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर वेबसाइट के फ़ॉर्मैट (nr.schedule.v1) में रखा जाता है, और ऐप में खोलने पर promptugal.news के साथ सिंक होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čuva se na ovom uređaju u formatu web-stranice (nr.schedule.v1) i sinkronizira s promptugal.news kad je otvorite u aplikaciji."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservato su questo dispositivo nel formato del sito (nr.schedule.v1) e sincronizzato con promptugal.news quando lo apri nell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウェブサイトの形式（nr.schedule.v1）でこのデバイスに保存され、アプリでpromptugal.newsを開いたときに同期されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹사이트 형식(nr.schedule.v1)으로 이 기기에 저장되고, 앱에서 promptugal.news를 열 때 동기화돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op dit apparaat bewaard in het formaat van de website (nr.schedule.v1) en gesynchroniseerd met promptugal.news wanneer je het in de app opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechowywane na tym urządzeniu w formacie strony (nr.schedule.v1) i synchronizowane z promptugal.news, gdy otworzysz ją w aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo neste aparelho no formato do site (nr.schedule.v1) e sincronizado com promptugal.news quando você o abre no app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado neste dispositivo no formato do site (nr.schedule.v1) e sincronizado com promptugal.news quando o abre na app."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrat pe acest dispozitiv în formatul site-ului (nr.schedule.v1) și sincronizat cu promptugal.news când se deschide în aplicație."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以网站格式 (nr.schedule.v1) 保存在此设备上，并在你于 App 中打开 promptugal.news 时与其同步。"
          }
        }
      }
    },
