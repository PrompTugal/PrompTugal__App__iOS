    "Stand-up reminders need a team identity (Team → Who are you?).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب تذكيرات الاجتماعات القصيرة هوية فريق (Team → Who are you?)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Stand-up-Erinnerungen ist eine Team-Identität nötig (Team → Wer sind Sie?)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand-up reminders need a team identity (Team → Who are you?)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios de reuniones de equipo necesitan una identidad de equipo (Equipo → ¿Quién eres?)."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios de reuniones de equipo necesitan una identidad de equipo (Equipo → ¿Quién sos?)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels de stand-up nécessitent une identité d’équipe (Équipe → Qui êtes-vous ?)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टैंड-अप रिमाइंडर के लिए टीम पहचान चाहिए (Team → Who are you?)।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsjetnici za stand-upove traže timski identitet (Tim → Tko ste vi?)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria degli stand-up richiedono un'identità nel team (Team → Chi sei?)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタンドアップのリマインダーにはチームIDが必要です（チーム → あなたは誰？）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스탠드업 알림에는 팀 ID가 필요해요(팀 → 누구세요?)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor stand-upherinneringen is een teamidentiteit nodig (Team → Wie ben je?)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia o stand-upach wymagają tożsamości w zespole (Zespół → Kim jesteś?)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes de stand-up precisam de uma identidade de equipe (Equipe → Quem é você?)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes de stand-up precisam de uma identidade de equipa (Equipa → Quem é?)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Memento-urile de stand-up necesită o identitate de echipă (Echipă → Cine ești?)."
          }
        },
        "zh-Hans": {
