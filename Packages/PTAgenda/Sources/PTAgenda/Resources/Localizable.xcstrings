    "Picks are read from your vault when it opens. Saving asks for Face ID and puts them where the website reads them.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُقرأ الاختيارات من خزنتك عند فتحها. يطلب الحفظ Face ID ويضعها حيث يقرؤها الموقع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriten werden beim Öffnen aus Ihrem Tresor gelesen. Das Sichern erfordert Face ID und legt sie dort ab, wo die Website sie liest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picks are read from your vault when it opens. Saving asks for Face ID and puts them where the website reads them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las favoritas se leen de tu bóveda al abrirla. Al guardar se pide Face ID y se dejan donde las lee el sitio web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les choix sont lus depuis votre coffre-fort à son ouverture. L’enregistrement demande Face ID et les place là où le site web les lit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके वॉल्ट के खुलने पर चुने सत्र उसमें से पढ़े जाते हैं। सहेजने के लिए Face ID माँगा जाता है और वे वहाँ रखे जाते हैं जहाँ से वेबसाइट उन्हें पढ़ती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odabiri se čitaju iz vašeg sefa kad se otvori. Spremanje traži Face ID i stavlja ih tamo gdje ih web-stranica čita."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scelte vengono lette dalla tua cassaforte quando la apri. Per salvare serve Face ID, e vengono messe dove le legge il sito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りはボールトを開くときに読み込まれます。保存にはFace IDが必要で、ウェブサイトが読み取る場所に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "볼트를 열 때 선택한 항목을 읽어 와요. 저장하려면 Face ID가 필요하고, 웹사이트가 읽는 위치에 저장돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorieten worden uit je kluis gelezen als die opent. Opslaan vraagt om Face ID en zet ze waar de website ze leest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrane sesje są odczytywane z sejfu przy jego otwarciu. Zapis wymaga Face ID i umieszcza je tam, gdzie czyta je strona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As escolhas são lidas do seu cofre quando ele abre. Salvar pede o Face ID e as coloca onde o site as lê."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As escolhas são lidas do seu cofre quando este abre. Guardar pede o Face ID e coloca-as onde o site as lê."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegerile se citesc din seif la deschiderea acestuia. Salvarea cere Face ID și le pune acolo unde le citește site-ul."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开保险库时会读取精选。保存时需要 Face ID，并会把精选放到网站读取的位置。"
          }
        }
      }
    },
    "Picks are read from your vault. To save, open it with its vault key and set an access token.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُقرأ الاختيارات من خزنتك. للحفظ، افتحها بمفتاح الخزنة وعيّن رمز وصول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriten werden aus Ihrem Tresor gelesen. Zum Sichern öffnen Sie ihn mit dem Tresorschlüssel und legen ein Zugriffstoken fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picks are read from your vault. To save, open it with its vault key and set an access token."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las favoritas se leen de tu bóveda. Para guardar, ábrela con su clave de bóveda y define un token de acceso."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "Las favoritas se leen de tu bóveda. Para guardar, abrila con su clave de bóveda y definí un token de acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les choix sont lus depuis votre coffre-fort. Pour enregistrer, ouvrez-le avec sa clé de coffre-fort et définissez un jeton d’accès."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने सत्र आपके वॉल्ट से पढ़े जाते हैं। सहेजने के लिए इसे वॉल्ट कुंजी से खोलें और एक एक्सेस टोकन सेट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odabiri se čitaju iz vašeg sefa. Za spremanje otvorite ga ključem sefa i postavite pristupni token."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scelte vengono lette dalla tua cassaforte. Per salvare, aprila con la sua chiave e imposta un token di accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りはボールトから読み込まれます。保存するには、ボールトキーでボールトを開き、アクセストークンを設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 항목은 볼트에서 읽어 와요. 저장하려면 볼트 키로 볼트를 열고 액세스 토큰을 설정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorieten worden uit je kluis gelezen. Om op te slaan open je hem met de kluissleutel en stel je een toegangstoken in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrane sesje są odczytywane z sejfu. Aby zapisać, otwórz go kluczem sejfu i ustaw token dostępu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As escolhas são lidas do seu cofre. Para salvar, abra-o com a chave do cofre e defina um token de acesso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As escolhas são lidas do seu cofre. Para guardar, abra-o com a chave do cofre e defina um token de acesso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegerile se citesc din seif. Pentru a salva, deschide-l cu cheia de seif și setează un token de acces."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精选从你的保险库读取。要保存，请用保险库密钥打开它并设置访问令牌。"
          }
        }
      }
    },
