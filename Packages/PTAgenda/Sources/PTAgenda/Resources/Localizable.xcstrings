    "Add sessions from the agenda here or with “Add to my day” on promptugal.news. Both make one list.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف جلسات من الجدول هنا أو عبر «أضف إلى يومي» على promptugal.news. كلاهما يكوّن قائمة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie Sessions hier aus dem Programm hinzu oder mit „Zu meinem Tag hinzufügen“ auf promptugal.news. Beides ergibt eine Liste."
          }
        },
        "de-CH": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie Sessions hier aus dem Programm hinzu oder mit «Zu meinem Tag hinzufügen» auf promptugal.news. Beides ergibt eine Liste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add sessions from the agenda here or with “Add to my day” on promptugal.news. Both make one list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade sesiones desde la agenda aquí o con «Añadir a mi día» en promptugal.news. Ambas forman una sola lista."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregá sesiones desde la agenda aquí o con «Agregar a mi día» en promptugal.news. Ambas forman una sola lista."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega sesiones desde la agenda aquí o con «Agregar a mi día» en promptugal.news. Ambas forman una sola lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des sessions depuis l’agenda ici ou avec « Ajouter à ma journée » sur promptugal.news. Les deux alimentent la même liste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एजेंडा से यहाँ सत्र जोड़ें या promptugal.news पर “मेरे दिन में जोड़ें” से। दोनों एक ही सूची बनाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte sesije iz rasporeda ovdje ili pomoću „Dodaj u moj dan” na promptugal.news. Oboje čini jedan popis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi le sessioni dall'agenda qui o con “Aggiungi alla mia giornata” su promptugal.news. Entrambi formano un'unica lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アジェンダからここにセッションを追加するか、promptugal.newsの「今日の予定に追加」を使います。どちらも1つのリストになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 일정의 세션을 추가하거나 promptugal.news의 “내 하루에 추가”를 사용하세요. 둘 다 하나의 목록이 돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg sessies toe vanuit het programma of met “Voeg toe aan mijn dag” op promptugal.news. Beide maken één lijst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodawaj sesje z agendy tutaj lub przez „Dodaj do mojego dnia” na promptugal.news. Obie drogi tworzą jedną listę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione sessões pela agenda aqui ou com “Adicionar ao meu dia” em promptugal.news. As duas formas geram uma única lista."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione sessões a partir da agenda aqui ou com «Adicionar ao meu dia» em promptugal.news. Ambos formam uma única lista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă sesiuni din agendă aici sau cu „Adaugă în ziua mea” pe promptugal.news. Ambele alcătuiesc o singură listă."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可在此处从日程表添加场次，也可在 promptugal.news 上用“添加到我的一天”。两者合为一个列表。"
          }
        }
      }
    },
