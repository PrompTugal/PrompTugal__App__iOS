          }
        }
      }
    },
    "Off by default. Keeps only the words of the conversation, in a file locked with the device; never the key or the data sent as context. Turning it off deletes the file.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. Keeps only the words of the conversation, in a file locked with the device; never the key or the data sent as context. Turning it off deletes the file."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado por padrão. Salva apenas o texto da conversa, em um arquivo bloqueado com o aparelho; nunca a chave nem os dados enviados como contexto. Desativar apaga o arquivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado por defeito. Guarda apenas o texto da conversa, num ficheiro bloqueado com o dispositivo; nunca a chave nem os dados enviados como contexto. Desativar apaga o ficheiro."
          }
        }
      }
    },
