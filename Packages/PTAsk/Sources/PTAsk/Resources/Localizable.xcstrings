    "Ask uses your own OpenRouter key. It is kept in this device's Keychain and sent only to openrouter.ai, with each question. You pay OpenRouter for what you ask.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask uses your own OpenRouter key. It is kept in this device's Keychain and sent only to openrouter.ai, with each question. You pay OpenRouter for what you ask."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Perguntar usa sua própria chave OpenRouter. Ela fica salva na Keychain deste aparelho e só é enviada para openrouter.ai, a cada pergunta. Você paga ao OpenRouter pelo que perguntar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Perguntar usa a sua própria chave OpenRouter. Fica guardada na Keychain deste dispositivo e só é enviada para openrouter.ai, com cada pergunta. Paga ao OpenRouter pelo que perguntar."
          }
        }
      }
    },
