    "Ask sends your question, the conversation and the data you share below to OpenRouter (openrouter.ai), which passes them to %@ to answer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask sends your question, the conversation and the data you share below to OpenRouter (openrouter.ai), which passes them to %@ to answer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Perguntar envia sua pergunta, a conversa e os dados que você compartilhar abaixo ao OpenRouter (openrouter.ai), que os repassa para %@ para responder."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Perguntar envia a sua pergunta, a conversa e os dados que partilhar abaixo para o OpenRouter (openrouter.ai), que os transmite para %@ para responder."
          }
        }
      }
    },
    "Ask settings": {
      "extractionState": "manual",
