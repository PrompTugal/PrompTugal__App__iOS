    "Your account has no newsroom notes lane yet. The website makes it the first time you send to the newsroom.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس لحسابك مسار ملاحظات غرفة الأخبار بعد. ينشئه الموقع عند أول إرسال إلى غرفة الأخبار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Konto hat noch keinen Redaktionsnotizen-Bereich. Die Website legt ihn an, wenn Sie zum ersten Mal an die Redaktion senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account has no newsroom notes lane yet. The website makes it the first time you send to the newsroom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta aún no tiene un carril de notas de redacción. El sitio web lo crea la primera vez que envías algo a la redacción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte n’a pas encore de canal de notes de rédaction. Le site web le crée la première fois que vous envoyez à la rédaction."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके खाते में अभी न्यूज़रूम नोट्स लेन नहीं है। न्यूज़रूम को पहली बार भेजने पर वेबसाइट इसे बना देती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš račun još nema traku bilješki redakcije. Web-stranica je stvara prvi put kad nešto pošaljete redakciji."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account non ha ancora una corsia per le note della redazione. Il sito la crea la prima volta che invii qualcosa alla redazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントにはまだ編集部ノートのレーンがありません。編集部に初めて送信すると、ウェブサイトが作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정에 아직 뉴스룸 노트 레인이 없어요. 뉴스룸에 처음 보낼 때 웹사이트가 만들어 줘요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account heeft nog geen notitiebaan voor de nieuwsredactie. De website maakt die aan zodra je voor het eerst naar de nieuwsredactie verstuurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje konto nie ma jeszcze ścieżki notatek redakcji. Strona tworzy ją przy pierwszym wysłaniu do redakcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta ainda não tem uma via de notas da redação. O site cria uma na primeira vez que você enviar algo para a redação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua conta ainda não tem uma via de notas da redação. O site cria-a da primeira vez que enviar algo para a redação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contul nu are încă un canal de note pentru redacție. Site-ul îl creează prima dată când trimiți ceva redacției."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账户还没有新闻编辑部笔记通道。你首次向编辑部发送内容时，网站会自动创建。"
          }
        }
      }
    },
