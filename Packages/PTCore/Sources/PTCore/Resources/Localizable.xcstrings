    "Writing needs your vault opened with its vault key (or passkey), not a read key.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب الكتابة فتح خزنتك بمفتاح الخزنة (أو مفتاح المرور)، لا بمفتاح للقراءة فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Schreiben muss Ihr Tresor mit dem Tresorschlüssel (oder Passkey) geöffnet sein, nicht mit einem Leseschlüssel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writing needs your vault opened with its vault key (or passkey), not a read key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para escribir hay que abrir la bóveda con su clave de bóveda (o llave de acceso), no con una clave de solo lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écriture exige que votre coffre-fort soit ouvert avec sa clé de coffre-fort (ou sa clé d’accès), et non une clé de lecture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिखने के लिए आपका वॉल्ट उसकी वॉल्ट कुंजी (या पासकी) से खुला होना चाहिए, रीड कुंजी से नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisanje traži vaš sef otvoren ključem sefa (ili pristupnim ključem), a ne ključem samo za čitanje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per scrivere serve la tua cassaforte aperta con la sua chiave (o passkey), non con una chiave di sola lettura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込みには、読み取り専用キーではなく、ボールトキー（またはパスキー）でボールトを開く必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰기에는 읽기 전용 키가 아니라 볼트 키(또는 패스키)로 연 볼트가 필요해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijven vereist dat je kluis is geopend met de kluissleutel (of passkey), niet met een leessleutel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapis wymaga sejfu otwartego kluczem sejfu (lub kluczem dostępu), a nie kluczem tylko do odczytu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para escrever, o cofre precisa ser aberto com a chave do cofre (ou passkey), não com uma chave só de leitura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para escrever, o cofre tem de ser aberto com a chave do cofre (ou passkey), não com uma chave só de leitura."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrierea necesită un seif deschis cu cheia de seif (sau passkey), nu cu o cheie de citire."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写入需要用保险库密钥（或通行密钥）打开保险库，只读密钥不行。"
          }
        }
      }
    },
