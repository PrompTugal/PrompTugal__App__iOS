    "The data changed shape and could not be read.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر شكل البيانات وتعذّرت قراءتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenstruktur hat sich geändert und konnte nicht gelesen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data changed shape and could not be read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos han cambiado de forma y no se han podido leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données ont changé de forme et n’ont pas pu être lues."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेटा का रूप बदल गया और उसे पढ़ा नहीं जा सका।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaci su promijenili oblik i nisu se mogli pročitati."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati hanno cambiato struttura e non è stato possibile leggerli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データの形式が変わり、読み取れませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터 형식이 바뀌어 읽을 수 없었어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gegevens zijn van vorm veranderd en konden niet worden gelezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane zmieniły strukturę i nie można ich odczytać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados mudaram de formato e não puderam ser lidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados mudaram de formato e não puderam ser lidos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele și-au schimbat forma și nu au putut fi citite."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据结构已变化，无法读取。"
          }
        }
      }
    },
