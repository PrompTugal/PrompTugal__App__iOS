    "Open your own vault first. A teammate's vault is never used as yours.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح خزنتك أولًا. لا تُستخدم خزنة زميل كخزنتك أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie zuerst Ihren eigenen Tresor. Der Tresor eines Teamkollegen wird nie als Ihrer verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open your own vault first. A teammate's vault is never used as yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre primero tu propia bóveda. La bóveda de un compañero nunca se usa como si fuera la tuya."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrí primero tu propia bóveda. La bóveda de un compañero nunca se usa como si fuera la tuya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez d’abord votre propre coffre-fort. Le coffre-fort d’un coéquipier n’est jamais utilisé comme le vôtre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले अपना खुद का वॉल्ट खोलें। किसी साथी का वॉल्ट आपके वॉल्ट के रूप में कभी इस्तेमाल नहीं होता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvo otvorite vlastiti sef. Sef kolege nikad se ne koristi kao vaš."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri prima la tua cassaforte. La cassaforte di un collega non viene mai usata come la tua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずご自身のボールトを開いてください。チームメイトのボールトがご自身のものとして使われることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 내 볼트를 여세요. 팀원의 볼트는 내 볼트로 사용되지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open eerst je eigen kluis. De kluis van een teamgenoot wordt nooit als de jouwe gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw otwórz własny sejf. Sejf współpracownika nigdy nie jest używany jako Twój."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra primeiro o seu próprio cofre. O cofre de um colega nunca é usado como o seu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra primeiro o seu próprio cofre. O cofre de um colega nunca é usado como o seu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide mai întâi propriul seif. Seiful unui coleg nu este folosit niciodată ca al tău."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先打开你自己的保险库。队友的保险库不会被当作你的。"
          }
        }
      }
    },
