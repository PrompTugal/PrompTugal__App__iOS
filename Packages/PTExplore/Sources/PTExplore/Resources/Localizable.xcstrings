    "The summit data loads once online, then works offline. %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحمَّل بيانات القمة مرة واحدة عند الاتصال بالإنترنت، ثم تعمل دونه. %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Summit-Daten werden einmal online geladen und funktionieren dann offline. %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The summit data loads once online, then works offline. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de la cumbre se cargan una vez con conexión y luego funcionan sin ella. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données du sommet se chargent une fois en ligne, puis fonctionnent hors ligne. %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समिट का डेटा ऑनलाइन होने पर एक बार लोड होता है, फिर ऑफ़लाइन चलता है। %@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaci summita učitavaju se jednom online, a zatim rade izvan mreže. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati del summit si caricano una volta online, poi funzionano offline. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サミットのデータはオンライン時に一度読み込まれ、その後はオフラインで使えます。%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서밋 데이터는 온라인에서 한 번 불러오면 오프라인에서도 사용할 수 있어요. %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De summitgegevens laden eenmaal online en werken daarna offline. %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane summitu wczytują się raz online, potem działają offline. %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados do evento carregam quando há conexão e depois funcionam offline. %@"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados da cimeira carregam quando há ligação e depois funcionam offline. %@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele summitului se încarcă o dată online, apoi funcționează offline. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "峰会数据联网后加载一次，之后即可离线使用。%@"
          }
        }
      }
    },
