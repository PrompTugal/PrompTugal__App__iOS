    "Set a passcode on this device to keep vault keys on it. Keys are never stored without Face ID or a passcode.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a passcode on this device to keep vault keys on it. Keys are never stored without Face ID or a passcode."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina uma senha neste aparelho para guardar chaves de cofre nele. As chaves nunca são salvas sem Face ID ou senha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina um código neste dispositivo para guardar nele chaves de cofre. As chaves nunca são guardadas sem Face ID ou código."
          }
        }
      }
    },
