    "The vault is open. Other apps can read the clipboard, so clearing it is safer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vault is open. Other apps can read the clipboard, so clearing it is safer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cofre está aberto. Outros apps podem ler a área de transferência, por isso é mais seguro limpá-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O cofre está aberto. Outras apps podem ler a área de transferência, por isso é mais seguro limpá-la."
          }
        }
      }
    },
