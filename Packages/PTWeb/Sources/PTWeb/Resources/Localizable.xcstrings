    "The website stopped responding. Try reloading the page.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف الموقع عن الاستجابة. جرّب إعادة تحميل الصفحة."
          }
        },
        "de": {
