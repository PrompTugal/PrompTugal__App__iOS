    "Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisá tu conexión e intentalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre connexion et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना कनेक्शन जाँचें और दोबारा कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerite vezu i pokušajte ponovno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 상태를 확인하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a conexão e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a ligação e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică conexiunea și încercați din nou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查网络连接后重试。"
          }
        }
      }
    },
    "Check your connection and try again. Cached sessions are available in Offline Reader.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من اتصالك وحاول مرة أخرى. الجلسات المخزّنة متاحة في «القارئ دون إنترنت»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie Ihre Verbindung und versuchen Sie es erneut. Zwischengespeicherte Sessions sind im Offline-Reader verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection and try again. Cached sessions are available in Offline Reader."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba tu conexión e inténtalo de nuevo. Las sesiones en caché están disponibles en el Lector sin conexión."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisá tu conexión e intentalo de nuevo. Las sesiones en caché están disponibles en el Lector sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre connexion et réessayez. Les sessions en cache sont disponibles dans le lecteur hors ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना कनेक्शन जाँचें और दोबारा कोशिश करें। कैश किए गए सत्र ऑफ़लाइन रीडर में उपलब्ध हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerite vezu i pokušajte ponovno. Sesije u predmemoriji dostupne su u Čitaču izvan mreže."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla la connessione e riprova. Le sessioni in cache sono disponibili in Lettore offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を確認して、もう一度お試しください。キャッシュ済みのセッションはオフラインリーダーで利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 상태를 확인하고 다시 시도하세요. 캐시된 세션은 오프라인 리더에서 볼 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer je verbinding en probeer het opnieuw. Gecachete sessies zijn beschikbaar in Offline Reader."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź połączenie i spróbuj ponownie. Sesje w pamięci podręcznej są dostępne w Czytniku offline."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a conexão e tente novamente. As sessões em cache estão disponíveis no Leitor offline."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a ligação e tente novamente. As sessões em cache estão disponíveis no Leitor offline."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică conexiunea și încercați din nou. Sesiunile din cache sunt disponibile în Cititorul offline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查网络连接后重试。已缓存的场次可在“离线阅读器”中查看。"
          }
        }
      }
    },
