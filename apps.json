{
  "packages": {
    "PTCore": {"path": "Packages/PTCore", "deps": []},
    "SGitVault": {"path": "Packages/SGitVault", "deps": []},
    "PTWeb": {"path": "Packages/PTWeb", "deps": ["PTCore"]},
    "PTNowNext": {"path": "Packages/PTNowNext", "deps": []},
    "PTAgenda": {"path": "Packages/PTAgenda", "deps": ["PTCore", "PTWeb", "PTNowNext"]},
    "PTNews": {"path": "Packages/PTNews", "deps": ["PTCore", "PTWeb", "SGitVault"]},
    "PTVaultUI": {"path": "Packages/PTVaultUI", "deps": ["PTCore", "SGitVault"]},
    "PTAsk": {"path": "Packages/PTAsk", "deps": ["PTCore", "PTAgenda", "PTNews", "PTVaultUI"]},
    "PTLanes": {"path": "Packages/PTLanes", "deps": ["PTCore", "PTVaultUI"]},
    "PTSync": {"path": "Packages/PTSync", "deps": ["PTCore"]},
    "PTDeck": {"path": "Packages/PTDeck", "deps": ["PTCore"]},
    "PTExplore": {"path": "Packages/PTExplore", "deps": ["PTCore"]},
    "PTFringe": {"path": "Packages/PTFringe", "deps": ["PTCore"]}
  },
  "apps": {
    "team": {"project": "Apps/Team/Team.xcodeproj", "scheme": "Team", "bundle": "news.promptugal.team",
             "paths": ["Apps/Team/"],
             "packages": ["PTLanes", "PTAsk"], "testflight": true},
    "promptugal": {"project": "Apps/PrompTugal/PrompTugal.xcodeproj", "scheme": "PrompTugal", "bundle": "news.promptugal.reader",
                   "paths": ["Apps/PrompTugal/"], "packages": ["PTAgenda", "PTNews", "PTDeck", "PTExplore", "PTSync"], "testflight": true},
    "riskmandate": {"project": "Apps/RiskMandate/RiskMandate.xcodeproj", "scheme": "RiskMandate", "bundle": "ai.riskmandate.app",
                    "paths": ["Apps/RiskMandate/"], "packages": ["PTCore"], "testflight": true},
    "fringe": {"project": "Apps/Fringe/Fringe.xcodeproj", "scheme": "Fringe", "bundle": "news.promptugal.fringe",
               "paths": ["Apps/Fringe/"], "packages": [], "testflight": true}
  },
  "all": [".github/workflows/ios.yml", ".github/workflows/ios-release.yml", "apps.json", "scripts/release/", "Config/Shared/", ".github/scripts/"]
}
